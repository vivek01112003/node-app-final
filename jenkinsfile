pipeline {
    agent any

    stages {

        stage("Clone") {
            steps {
                checkout scm
            }
        }

        stage("Build") {
            steps {
                sh "docker build -t node-todo-app:latest ."
            }
        }

        stage("Deploy") {
            steps {
                sh '''
                    docker stop node-todo-app || true
                    docker rm node-todo-app || true

                    docker run -d \
                      --name node-todo-app \
                      --restart unless-stopped \
                      -p 3000:3000 \
                      node-todo-app:latest
                '''
            }
        }
    }
}

